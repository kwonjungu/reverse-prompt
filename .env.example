# Google Gemini API (server-side, for Genkit flows)
# https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# (optional) Fallback / pool of keys for rate limit rotation
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3

# Firebase web app config (Project settings → General → 내 앱 → Config)
# https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ── v7 연구용 설정 (서버 전용) ────────────────────────────────
# 이 값들이 비어 있으면 연구용 흐름을 열지 않는다(researchReady=false).

# 채점 모델. 비워 두면 기본값 googleai/gemini-3.8-flash 로 동작한다.
# EVALUATION_MODEL_ID=googleai/gemini-3.8-flash
# EVALUATION_TEMPERATURE=0.2
# 운영자가 모델 접근과 출력 스키마를 실제로 확인했을 때에만 true 로 둔다.
EVALUATION_MODEL_VERIFIED=false

# 비공개 연구 자산 디렉터리(검사 이미지 + cue-pack.json). 저장소 밖 경로를 쓴다.
RESEARCH_ASSET_DIR=

# 서버 권한 검증용 Firebase Admin 자격(JSON 문자열). 없으면 서버 인증이 실패한다.
FIREBASE_SERVICE_ACCOUNT_JSON=

# 학생 세션 토큰 서명 키와 참가자 코드 pepper. 임의의 긴 난수를 쓴다.
STUDENT_SESSION_SECRET=
PARTICIPANT_CODE_PEPPER=

# 현재 유효한 동의서 버전. 비어 있으면 연구 동의를 받을 수 없다.
CONSENT_VERSION=

# IRB 승인 번호. 코드가 만들어 낼 수 없는 값이므로 비어 있으면 연구 시작을 막는다.
IRB_APPROVAL=
